<?xml version="1.0" encoding="UTF-8"?>
<!-- Indice de sitemaps. Las paginas estaticas viven en GitHub Pages
     (sitemap-pages.xml); los perfiles, listas y rankings publicos los
     renderiza el backend y se listan solos en /u/sitemap.xml, que Cloudflare
     enruta al backend con el mismo route playloggr.com/u/* que las paginas. -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://playloggr.com/sitemap-pages.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://playloggr.com/u/sitemap.xml</loc>
  </sitemap>
</sitemapindex>
