{
  "name": "Playloggr",
  "short_name": "Playloggr",
  "description": "Tu backlog de videojuegos: Steam, PlayStation, Xbox, GOG y Epic en una sola lista.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1a1a",
  "theme_color": "#132420",
